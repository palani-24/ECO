# ECO Frontend Environment Variables Template

# Backend API URL (Optional, defaults to relative /api or http://localhost:5000 in dev)
VITE_API_BASE_URL=https://your-backend-api.onrender.com

# Google Maps API Key for Real-Time Location, Navigation & Routing
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key_here
