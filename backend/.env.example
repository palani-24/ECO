# ECO Backend Environment Variables Template

# MongoDB Database Connection URI (MongoDB Atlas or Local)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ecoreward?retryWrites=true&w=majority

# JWT Secret Key for User/Driver/Admin Token Auth
JWT_SECRET=ecoreward_secure_jwt_secret_key_2026

# Google Gemini API Key for Real AI Waste Classification (Optional)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Server Port
PORT=5000

# Node Environment
NODE_ENV=production
